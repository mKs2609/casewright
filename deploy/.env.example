# The names deploy/compose.yaml needs (step 19a). The real file, deploy/.env, is made on the server
# by deploy/make-secrets.sh, with fresh random values, and is never committed.

# The site's name, and the address browsers use (for the cross-site check).
SITE_ADDRESS=casewright.duckdns.org
PUBLIC_ORIGIN=https://casewright.duckdns.org

# The database's superuser (used only to create the application's role at first start) and the
# application's own limited role.
POSTGRES_PASSWORD=
DB_PASSWORD=

# The same secrets as the root .env.example, with fresh values for the server.
JWT_SIGNING_KEY=
SSL_KEYSTORE_PASSWORD=
BASELINE_ENCRYPTION_KEY=
AGENT_SERVICE_TOKEN=
AUDIT_HMAC_KEY=
