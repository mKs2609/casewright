# Copy of the variable NAMES the project needs. Real values live in .env, which is never committed.

# Database. Run scripts\setup-db.ps1 to create these with a generated password.
DB_URL=jdbc:postgresql://localhost:5432/secanalyst
DB_USER=secanalyst_app
DB_PASSWORD=

# Signs access tokens: 32+ random bytes, Base64. Run scripts\setup-secrets.ps1 to generate it.
JWT_SIGNING_KEY=

# Protects the HTTPS keystore file (certs/gateway-dev.p12). Run scripts\setup-secrets.ps1, then scripts\setup-https.ps1.
SSL_KEYSTORE_PASSWORD=

# Encrypts employee baselines in the database: exactly 32 random bytes, Base64. Run scripts\setup-secrets.ps1.
BASELINE_ENCRYPTION_KEY=

# Shared secret the gateway sends to the agent service on every call (both read it from here).
# 32+ random bytes, Base64. Run scripts\setup-secrets.ps1.
AGENT_SERVICE_TOKEN=

# The agent's AI model (ADR-15). Not secret. off: the fixed plan only. ollama: a local model chooses
# the tools; needs Ollama installed and the model pulled once (ollama pull qwen3:8b). The address
# must be on this machine: the agent refuses to start otherwise.
LLM_PROVIDER=off
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
