# Copy of the variable NAMES the project needs. Real values live in .env, which is never committed.

# Database. Run scripts\setup-db.ps1 to create these with a generated password.
DB_URL=jdbc:postgresql://localhost:5432/secanalyst
DB_USER=secanalyst_app
DB_PASSWORD=

# Signs access tokens: 32+ random bytes, Base64. Run scripts\setup-secrets.ps1 to generate it.
JWT_SIGNING_KEY=
