// "Open in GitHub Codespaces" (step 19d, ADR-62): a private copy of the whole system for whoever
// opens it, running on their own free Codespaces hours. It builds and starts the same containers as
// a server (deploy/compose.yaml) inside the codespace; deploy/codespaces-start.sh does the work.
{
  "name": "Casewright demo",

  // Ubuntu 24.04 with the usual command-line tools (version 3.0.12), pinned by digest like every
  // base image here.
  "image": "mcr.microsoft.com/devcontainers/base:3.0.12-ubuntu24.04@sha256:ec556aed93f62aa6d13fe72c5db09da4e29a7c9b87c568dbca0ee5717466926a",

  "features": {
    // Docker inside the codespace: the docker-in-docker feature at an exact version; its digest is
    // recorded in devcontainer-lock.json, next to this file.
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },

  // The smallest machine (2 cores, 8 GB) is enough, and uses the visitor's free hours slowest.
  "hostRequirements": { "cpus": 2, "memory": "8gb" },

  // Every start, including after the codespace was stopped: builds if needed, then starts everything.
  "postStartCommand": "bash deploy/codespaces-start.sh",

  // Only the front door is offered to the visitor; GitHub keeps it private to them.
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "Casewright", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
