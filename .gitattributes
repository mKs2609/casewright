# Files that run inside Linux containers keep Linux line endings (LF) on every machine, even when
# they are edited on Windows: a shell script with Windows line endings fails with "not found" errors.
*.sh            text eol=lf
gateway/mvnw    text eol=lf
deploy/Caddyfile text eol=lf
*.Dockerfile    text eol=lf
Dockerfile      text eol=lf
